# copy to .env and adjust (FritzBox 192.168.178.1, Unraid 192.168.178.77)
HOME_NET=192.168.178.0/24
# outside the DHCP range of the FritzBox (default 192.168.178.20 - .200)
WLT_UPDATE_IP=192.168.178.250
WLT_DNS_IP=192.168.178.251
DATA_PATH=/mnt/user/appdata/wlt-update
GITHUB_REPO=allgrinder/WLANThermo_ESP32_Softwareclaude
# only needed if the fork is private: fine-grained token, read only,
# only this repository, permission "Contents: Read-only"
GITHUB_TOKEN=
POLL_INTERVAL_S=1800
ROLLBACK_TAGS=v1.2.4
