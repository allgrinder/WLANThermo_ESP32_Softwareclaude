<?xml version="1.0"?>
<!--
  Unraid template for wlt-dns (WLANThermo gas fork), GPL-3.0.
  Install: copy to /boot/config/plugins/dockerMan/templates-user/ and choose
  it under Docker -> Add Container -> Template. See docs/INSTALL-GAS.md.
  Only needed for the first update, can be stopped afterwards.
-->
<Container version="2">
  <Name>wlt-dns</Name>
  <Repository>ghcr.io/allgrinder/wlt-dns:latest</Repository>
  <Registry>https://github.com/allgrinder/WLANThermo_ESP32_Softwareclaude/pkgs/container/wlt-dns</Registry>
  <Network>br0</Network>
  <MyIP>192.168.178.251</MyIP>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/allgrinder/WLANThermo_ESP32_Softwareclaude</Support>
  <Project>https://github.com/allgrinder/WLANThermo_ESP32_Softwareclaude/tree/feature/gas-smart-control/update-server</Project>
  <Overview>Minimal DNS server (dnsmasq) for the first update of the WLANThermo gas fork: answers api.wlanthermo.de with the IP of wlt-update, forwards everything else to public resolvers. Only needed for the first update, can be stopped afterwards.</Overview>
  <Category>Network:DNS</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart=unless-stopped --security-opt no-new-privileges:true --cap-drop=ALL --cap-add=NET_BIND_SERVICE --cap-add=SETUID --cap-add=SETGID --cap-add=CHOWN</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>Fixed IP in br0 outside the DHCP range of the FritzBox. Never use the FritzBox as upstream (loop).</Requires>
  <Config Name="OVERRIDE_IP" Target="OVERRIDE_IP" Default="192.168.178.250" Mode="" Description="Fixed IP of the wlt-update container" Type="Variable" Display="always" Required="true" Mask="false">192.168.178.250</Config>
  <Config Name="OVERRIDE_HOST" Target="OVERRIDE_HOST" Default="api.wlanthermo.de" Mode="" Description="Host that is redirected" Type="Variable" Display="advanced" Required="true" Mask="false">api.wlanthermo.de</Config>
  <Config Name="OVERRIDE_TTL" Target="OVERRIDE_TTL" Default="60" Mode="" Description="TTL of the redirect in seconds" Type="Variable" Display="advanced" Required="false" Mask="false">60</Config>
  <Config Name="UPSTREAM_SERVERS" Target="UPSTREAM_SERVERS" Default="1.1.1.1,9.9.9.9" Mode="" Description="Public resolvers for everything else, NOT the FritzBox" Type="Variable" Display="advanced" Required="true" Mask="false">1.1.1.1,9.9.9.9</Config>
  <Config Name="LOG_QUERIES" Target="LOG_QUERIES" Default="0" Mode="" Description="1 = log every DNS query" Type="Variable" Display="advanced" Required="false" Mask="false">0</Config>
</Container>
